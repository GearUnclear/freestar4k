await (async (page) => {
 await page.evaluate(() => {
  const v=document.querySelector("video");
  window.weatherAudit={start:new Date().toISOString(),samples:[],events:[]};
  for(const name of ["waiting","stalled","error","playing","ended"])v.addEventListener(name,()=>window.weatherAudit.events.push({time:new Date().toISOString(),name,currentTime:v.currentTime}));
  const canvas=document.createElement("canvas");canvas.width=160;canvas.height=120;const ctx=canvas.getContext("2d",{willReadFrequently:true});
  window.weatherAudit.timer=setInterval(()=>{
   let black=null;try{ctx.drawImage(v,0,0,160,120);const d=ctx.getImageData(0,0,160,120).data;let n=0;for(let i=0;i<d.length;i+=4)if(d[i]<16&&d[i+1]<16&&d[i+2]<16)n++;black=n/(d.length/4);}catch(e){}
   const q=v.getVideoPlaybackQuality();window.weatherAudit.samples.push({time:Date.now(),currentTime:v.currentTime,paused:v.paused,ready:v.readyState,status:document.querySelector("#status").textContent,black,frames:q.totalVideoFrames,dropped:q.droppedVideoFrames});
  },250);
 });
 for(let i=0;i<120;i++){await page.locator("video").screenshot({path:"output/playwright/weather-final-20260929/frame-"+new Date().toISOString().replace(/[:.]/g,"-")+".png"});await page.waitForTimeout(5000);}
 return await page.evaluate(()=>{clearInterval(window.weatherAudit.timer);return {start:window.weatherAudit.start,samples:window.weatherAudit.samples.length};});
})(page);
